{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "backend", "format": "url", "env": "API_URL" }]
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
